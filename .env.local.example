# ── Gemini ───────────────────────────────────────────
# Buat di https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=isi_api_key_gemini
GEMINI_MODEL=gemini-2.5-flash

# ── Dashboard ────────────────────────────────────────
DASHBOARD_PASSWORD=ganti-dengan-password-kuat
# String acak panjang (contoh: openssl rand -hex 32)
AUTH_SECRET=ganti-dengan-string-acak

# ── Database (opsional) Neon: https://neon.tech ──────
# Kosongkan jika tidak mau menyimpan riwayat chat
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ── WhatsApp Cloud API (Meta) ────────────────────────
WHATSAPP_TOKEN=isi_access_token_meta
WHATSAPP_PHONE_NUMBER_ID=isi_phone_number_id
# Bebas, harus sama dengan yang diisi di dashboard Meta saat verifikasi webhook
WHATSAPP_VERIFY_TOKEN=ganti-dengan-token-verifikasi
# App Secret dari Meta (App settings > Basic) untuk validasi signature
WHATSAPP_APP_SECRET=isi_app_secret
# Opsional: hanya nomor ini yang dilayani, pisahkan dengan koma (format 628xxx tanpa +)
WHATSAPP_ALLOWED_NUMBERS=628123456789
